{
  "name": "arknights-en-voice-player",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "check": "npm run lint && npm run test:sync && npm run validate:voices && npm run build",
    "test:sync": "node --test tests/stateMerge.test.mjs tests/validateVoiceData.test.mjs tests/operatorInitials.test.mjs tests/gameMode.test.mjs tests/gameCatalog.test.mjs",
    "generate:endfield-data": "node --use-system-ca scripts/generate-endfield-data.mjs",
    "generate:voices": "node --use-system-ca scripts/generate-voice-data.mjs",
    "validate:voices": "node scripts/validate-voice-data.mjs",
    "validate:voices:audio": "node --use-system-ca scripts/validate-voice-data.mjs --audio",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
